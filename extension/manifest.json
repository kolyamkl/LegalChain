{
  "manifest_version": 3,
  "name": "LegalChain - Smart Contract Security",
  "version": "1.0.0",
  "description": "AI-powered smart contract security analysis. Scan contracts for vulnerabilities and risks.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:3002/*",
    "https://*.etherscan.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.etherscan.io/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
